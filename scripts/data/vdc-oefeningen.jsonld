    {
      "@id": "vdc:exercise/custom/mask-flood-hover",
      "@type": "ExercisePlan",
      "name": "Masker klaren in zweefhouding",
      "description": "Masker deels en volledig laten vollopen en klaren zonder trim te verliezen.",
      "activityDuration": "PT10M",
      "step": [
        { "@type": "HowToStep", "text": "Start in stabiele hover op borsthoogte in diep gedeelte." },
        { "@type": "HowToStep", "text": "Laat masker half vollopen en klaren op een gecontroleerde manier." },
        { "@type": "HowToStep", "text": "Herhaal met volledig vollopen en klaren." },
        { "@type": "HowToStep", "text": "Buddy controleert rust en signalen na elke klaarbeweging." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Maskervaardigheid in trim" }],
