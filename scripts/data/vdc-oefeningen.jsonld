    {
      "@id": "vdc:exercise/custom/kompas-oriemtatie-lijnen",
      "@type": "ExercisePlan",
      "name": "Kompasorientatie langs zwarte lijnen",
      "description": "Duo's volgen met beperkte zichtsimulatie een traject langs de zwarte lijnen op de bodem en komen exact op startpunt terug.",
      "activityDuration": "PT10M",
      "step": [
        { "@type": "HowToStep", "text": "Leg vooraf 3 duidelijke keerpunten vast (ondiep, midden, diep)." },
        { "@type": "HowToStep", "text": "Duiker A navigeert met kompas, duiker B checkt afstand en veiligheid." },
        { "@type": "HowToStep", "text": "Wissel rollen na 1 volledige ronde." },
        { "@type": "HowToStep", "text": "Bespreek na elke ronde afwijking en corrigeer heading." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Orientatie en navigatie" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Graduate, Bachelor" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "section", "value": "exercise" },
        { "@type": "PropertyValue", "name": "difficulty", "value": "graduate,bachelor" },
        { "@type": "PropertyValue", "name": "repetitions", "value": "2x" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "2" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/finning-ladder",
      "@type": "ExercisePlan",
      "name": "Finning ladder (tempo-opbouw)",
      "description": "Opbouwset met korte en langere stukken aan stijgend tempo, telkens met gecontroleerde recuperatie.",
      "activityDuration": "PT15M",
      "supply": [{ "@type": "HowToSupply", "name": "Backpacks voor uithouding" }],
      "step": [
        { "@type": "HowToStep", "text": "Start met 25% tempo over een halve lengte." },
        { "@type": "HowToStep", "text": "Verhoog per ronde met 25% tot 100%, met 20 seconden herstel op snorkel." },
        { "@type": "HowToStep", "text": "Laat buddies elkaars vintechniek observeren en 1 tip geven." },
        { "@type": "HowToStep", "text": "Laatste ronde op 75% met focus op rustige ademhaling." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Vintechniek en pacing" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Initiate, Graduate" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "section", "value": "exercise" },
        { "@type": "PropertyValue", "name": "difficulty", "value": "initiate,graduate" },
        { "@type": "PropertyValue", "name": "repetitions", "value": "4 ladders" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "2" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/opwarming-mobility",
      "@type": "ExercisePlan",
      "name": "Mobiliteitsopwarming in ondiep water",
      "description": "Lichte mobiliteit en techniekoefeningen in ondiep water voor schouders, heupen en enkels.",
      "activityDuration": "PT10M",
      "step": [
        { "@type": "HowToStep", "text": "Start met 2 minuten rustige verplaatsingen zonder materiaal." },
        { "@type": "HowToStep", "text": "Voeg rotatie-oefeningen toe voor schouders en heupen." },
        { "@type": "HowToStep", "text": "Doe 2 korte balansdrills met gecontroleerde uitstoot." },
        { "@type": "HowToStep", "text": "Eindig met 1 lengte rustige vinbewegingen." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Mobiliteit en blessurepreventie" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Initiate, Graduate, Bachelor" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "section", "value": "warmup" },
        { "@type": "PropertyValue", "name": "difficulty", "value": "initiate,graduate,bachelor" },
        { "@type": "PropertyValue", "name": "repetitions", "value": "1x" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "1" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/no-mask-line-swap",
      "@type": "ExercisePlan",
      "name": "Wissel zonder masker op lijn",
      "description": "Twee buddyteams wisselen op vaste punten materiaal op de lijn zonder zicht, met continue communicatie.",
      "activityDuration": "PT15M",
      "step": [
        { "@type": "HowToStep", "text": "Duid 3 wisselpunten aan op de zwarte lijn." },
        { "@type": "HowToStep", "text": "Team A start zonder masker, team B bewaakt en begeleidt." },
        { "@type": "HowToStep", "text": "Op elk wisselpunt worden 2 taken uitgewisseld (masker, octo, positie)." },
        { "@type": "HowToStep", "text": "Na elke ronde evalueren op rust, signalen en controle." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Communicatie onder stress" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Graduate, Bachelor" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "section", "value": "exercise" },
