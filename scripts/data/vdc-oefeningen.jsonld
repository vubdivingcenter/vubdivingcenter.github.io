        { "@type": "PropertyValue", "name": "repetitions", "value": "2 cycli" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "4" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/cooldown-breath-reset",
      "@type": "ExercisePlan",
      "name": "Rustige adem-afsluiter",
      "description": "Rustige afbouw met drijf- en ademritmeoefeningen na intensieve reeksen.",
      "activityDuration": "PT5M",
      "step": [
        { "@type": "HowToStep", "text": "Laat de groep in ondiep drijven met langzame uitademing." },
        { "@type": "HowToStep", "text": "Gebruik een ritme van 4 tellen in, 6 tellen uit." },
        { "@type": "HowToStep", "text": "Voeg 2 korte mobiliteitsbewegingen toe voor schouders en nek." },
        { "@type": "HowToStep", "text": "Rond af met materiaalcontrole en gezamenlijke OK-check." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Herstel en afsluiting" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Initiate, Graduate, Bachelor" },
