        { "@type": "PropertyValue", "name": "repetitions", "value": "3 rondes" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "4" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/buddy-briefing-sprint",
      "@type": "ExercisePlan",
      "name": "Buddybriefing estafette",
      "description": "Korte briefing-uitvoering-nabespreking cyclus waarbij elk buddyteam een mini-oefening ontwerpt en uitvoert.",
      "activityDuration": "PT10M",
      "step": [
        { "@type": "HowToStep", "text": "Geef elk buddypaar 60 seconden om een mini-opdracht te kiezen." },
        { "@type": "HowToStep", "text": "Laat hen de opdracht 1 keer demonstreren met veiligheidsrolverdeling." },
        { "@type": "HowToStep", "text": "Laat de rest van de groep de opdracht uitvoeren." },
        { "@type": "HowToStep", "text": "Sluit af met 1 verbeterpunt en 1 positief punt per team." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Briefing en leiderschap" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Initiate, Graduate, Bachelor" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "section", "value": "exercise" },
