    {
      "@id": "vdc:exercise/custom/helicopter-turn-gates",
      "@type": "ExercisePlan",
      "name": "Helicopter-turn poortjes",
      "description": "Rotatie-oefening waarbij duikers in krappe poortjes draaien zonder te raken.",
      "activityDuration": "PT10M",
      "supply": [{ "@type": "HowToSupply", "name": "Enkele hoepels" }],
      "step": [
        { "@type": "HowToStep", "text": "Plaats 3 poortjes met hoepels of stokken op diepte." },
        { "@type": "HowToStep", "text": "Duiker draait 360 graden in elk poortje met vincontrole." },
        { "@type": "HowToStep", "text": "Buddy observeert of trim horizontaal blijft." },
        { "@type": "HowToStep", "text": "Verklein daarna de draaicirkel voor gevorderde ronde." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Helicopter turn controle" }],
