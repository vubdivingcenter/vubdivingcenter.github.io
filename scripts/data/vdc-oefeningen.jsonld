      "@type": "ExercisePlan",
      "name": "Zwemcontrole zonder masker",
      "description": "Korte trajecten zonder masker met rustige ademhaling en buddybegeleiding.",
      "activityDuration": "PT10M",
      "step": [
        { "@type": "HowToStep", "text": "Duiker verwijdert masker op veilige diepte." },
        { "@type": "HowToStep", "text": "Zwemt halve lengte op trim met buddy ernaast." },
        { "@type": "HowToStep", "text": "Masker terug opzetten en klaren voor terugkeer." },
        { "@type": "HowToStep", "text": "Wissel rollen en herhaal met feedback." }
