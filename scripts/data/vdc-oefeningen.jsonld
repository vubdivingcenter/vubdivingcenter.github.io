        { "@type": "PropertyValue", "name": "repetitions", "value": "1x" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "1" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/static-hover-box",
      "@type": "ExercisePlan",
      "name": "Stabiel zweven in vak",
      "description": "Duo's blijven zweven binnen een denkbeeldig vierkant zonder bodem of oppervlak te raken.",
      "activityDuration": "PT10M",
      "step": [
        { "@type": "HowToStep", "text": "Markeer een zone in het zwembad met vier referentiepunten." },
        { "@type": "HowToStep", "text": "Laat duo's 45 seconden zweven met minimale vinbeweging." },
        { "@type": "HowToStep", "text": "Wissel na elke ronde van positie en diepte." },
        { "@type": "HowToStep", "text": "Beloon teams die volledig stabiel blijven met een extra uitdaging." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Trim en drijfvermogen" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Initiate, Graduate, Bachelor" },
