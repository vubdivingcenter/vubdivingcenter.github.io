    {
      "@id": "vdc:exercise/custom/team-hover-sync",
      "@type": "ExercisePlan",
      "name": "Groepszweef-synchronisatie",
      "description": "Groepsoefening waarbij alle duikers tegelijk stijgen, dalen en stabiliseren op afgesproken signaal.",
      "activityDuration": "PT10M",
      "step": [
        { "@type": "HowToStep", "text": "Groep vormt lijn op gelijke diepte." },
        { "@type": "HowToStep", "text": "Instructeur geeft ritmische signalen voor +0.5m, -0.5m en stop." },
        { "@type": "HowToStep", "text": "Iedereen moet binnen 3 seconden op hetzelfde niveau staan." },
        { "@type": "HowToStep", "text": "Herhaal met gesloten ogen voor 1 duiker per ronde." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Drijfvermogen-synchronisatie" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Graduate, Bachelor" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "section", "value": "exercise" },
        { "@type": "PropertyValue", "name": "difficulty", "value": "graduate,bachelor" },
        { "@type": "PropertyValue", "name": "repetitions", "value": "5 signalreeksen" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "4" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/tired-diver-tow",
      "@type": "ExercisePlan",
      "name": "Vermoeide duiker slepen",
      "description": "Simulatie van vermoeide duiker die veilig naar kant wordt getrokken met correcte greep.",
      "activityDuration": "PT10M",
      "step": [
        { "@type": "HowToStep", "text": "Demonstreer eerst 2 sleepgrepen aan oppervlakte." },
        { "@type": "HowToStep", "text": "Voer per buddy 1 lengte sleepoefening uit met rolwissel." },
        { "@type": "HowToStep", "text": "Controleer tijdens het slepen steeds luchtweg en communicatie." },
        { "@type": "HowToStep", "text": "Sluit af met evaluatie op efficiëntie en veiligheid." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Rescue basisvaardigheid" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Initiate, Graduate" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "section", "value": "exercise" },
        { "@type": "PropertyValue", "name": "difficulty", "value": "initiate,graduate" },
        { "@type": "PropertyValue", "name": "repetitions", "value": "2x per buddy" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "2" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/weight-hot-potato",
      "@type": "ExercisePlan",
      "name": "Loodzak doorgeefspel",
      "description": "Kleine gewichtszak wordt rondgegeven in zweefpositie; elke doorgave vereist snelle drijfvermogen-correctie.",
      "activityDuration": "PT10M",
      "step": [
        { "@type": "HowToStep", "text": "Groep vormt cirkel in trimpositie." },
        { "@type": "HowToStep", "text": "Geef gewicht door op fluitsignaal, zonder bodemcontact." },
        { "@type": "HowToStep", "text": "Verhoog tempo elke minuut." },
        { "@type": "HowToStep", "text": "Stop wanneer iemand bodem raakt en herstart met feedback." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Task-loading en stabiliteit" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Graduate, Bachelor" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "section", "value": "exercise" },
        { "@type": "PropertyValue", "name": "difficulty", "value": "graduate,bachelor" },
        { "@type": "PropertyValue", "name": "repetitions", "value": "5 minuten spel + debrief" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "4" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/underwater-frisbee-control",
      "@type": "ExercisePlan",
      "name": "Onderwaterfrisbee controle",
      "description": "Duo's passen frisbee of torpedo onder water zonder verlies van trim en zonder bodemcontact.",
      "activityDuration": "PT10M",
      "supply": [
        { "@type": "HowToSupply", "name": "Onderwaterfrisbee" },
        { "@type": "HowToSupply", "name": "3 mini torpedo's" }
      ],
      "step": [
        { "@type": "HowToStep", "text": "Definieer speelzone met duidelijke grenzen." },
        { "@type": "HowToStep", "text": "Laat duo's 8 gecontroleerde passen uitvoeren." },
        { "@type": "HowToStep", "text": "Tel enkel geldige passen zonder bodemcontact." },
        { "@type": "HowToStep", "text": "Laat teams daarna snelheid opvoeren met behoud van controle." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Trim onder taakbelasting" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Initiate, Graduate, Bachelor" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "section", "value": "exercise" },
        { "@type": "PropertyValue", "name": "difficulty", "value": "initiate,graduate,bachelor" },
        { "@type": "PropertyValue", "name": "repetitions", "value": "2 rondes" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "2" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/knikkers-opduiken-patroon",
      "@type": "ExercisePlan",
      "name": "Knikkers opduiken in patroon",
      "description": "Kandidaten duiken knikkers op volgens een kleur- of volgordepatroon voor concentratie en controle.",
      "activityDuration": "PT10M",
      "supply": [{ "@type": "HowToSupply", "name": "Knikkers" }],
      "step": [
        { "@type": "HowToStep", "text": "Leg knikkers verspreid op bodem in het diepe." },
        { "@type": "HowToStep", "text": "Geef per duo een patroon (bv. rood-blauw-groen)." },
        { "@type": "HowToStep", "text": "Elke duiker haalt 1 knikker per duik en wisselt af." },
        { "@type": "HowToStep", "text": "Controleer of patroon correct is en herhaal met moeilijkere volgorde." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Focus en gecontroleerde eendenduik" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Initiate, Graduate" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "section", "value": "exercise" },
        { "@type": "PropertyValue", "name": "difficulty", "value": "initiate,graduate" },
        { "@type": "PropertyValue", "name": "repetitions", "value": "3 patronen" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "2" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/dobbelstenen-opdrachtencircuit",
      "@type": "ExercisePlan",
      "name": "Dobbelstenen opdrachtencircuit",
      "description": "Elke worp met dobbelstenen bepaalt de volgende mini-opdracht in een circuit.",
      "activityDuration": "PT10M",
      "supply": [{ "@type": "HowToSupply", "name": "Dobbelstenen" }],
      "step": [
        { "@type": "HowToStep", "text": "Maak een lijst met 6 mini-opdrachten (1 per dobbelsteenwaarde)." },
        { "@type": "HowToStep", "text": "Laat elk team rollen en opdracht meteen uitvoeren." },
        { "@type": "HowToStep", "text": "Herhaal 4 rondes met stijgende moeilijkheid." },
        { "@type": "HowToStep", "text": "Sluit af met de opdracht die het vaakst verkeerd ging." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Reactie en taakwisseling" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Initiate, Graduate, Bachelor" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "section", "value": "exercise" },
        { "@type": "PropertyValue", "name": "difficulty", "value": "initiate,graduate,bachelor" },
        { "@type": "PropertyValue", "name": "repetitions", "value": "4 rondes" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "2" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/buisjes-steentjes-estafette",
      "@type": "ExercisePlan",
      "name": "Buisjes met steentjes estafette",
      "description": "Teams brengen zinkende buisjes met steentjes gecontroleerd over van diep naar ondiep in estafettevorm.",
      "activityDuration": "PT10M",
      "supply": [{ "@type": "HowToSupply", "name": "Buisjes met steentjes die zinken" }],
      "step": [
        { "@type": "HowToStep", "text": "Leg buisjes op 2 zones op de bodem in diep." },
        { "@type": "HowToStep", "text": "Duiker haalt 1 buisje op en geeft door aan buddy op middenzone." },
        { "@type": "HowToStep", "text": "Buddy brengt buisje verder naar ondiep en plaatst in bak." },
        { "@type": "HowToStep", "text": "Wissel na elke ronde van rol." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Teamcoordinatie en drijfcontrole met object" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Graduate, Bachelor" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "section", "value": "exercise" },
        { "@type": "PropertyValue", "name": "difficulty", "value": "graduate,bachelor" },
        { "@type": "PropertyValue", "name": "repetitions", "value": "3 estafettes" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "4" },
        { "@type": "PropertyValue", "name": "setupEffort", "value": "meer" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/regelaar-switch-binnen-buiten",
      "@type": "ExercisePlan",
      "name": "Regelaar-switch binnen en buiten ontspanner",
      "description": "Per buddy wordt gecontroleerd geschakeld tussen binnenontspanner en buitenontspanner met stabiele trim.",
      "activityDuration": "PT12M",
      "supply": [
        { "@type": "HowToSupply", "name": "Jacket" },
        { "@type": "HowToSupply", "name": "Fles" },
        { "@type": "HowToSupply", "name": "Binnenontspanner" },
        { "@type": "HowToSupply", "name": "Buitenontspanner (octopus)" }
      ],
      "step": [
        { "@type": "HowToStep", "text": "Brief de volgorde: primair ademen, wissel, controleteken, terugwissel." },
        { "@type": "HowToStep", "text": "Buddy A voert 3 gecontroleerde switches uit terwijl buddy B observeert." },
        { "@type": "HowToStep", "text": "Wissel rollen en herhaal op identieke diepte." },
        { "@type": "HowToStep", "text": "Rond af met gezamenlijke evaluatie op rust en stabiliteit." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Luchtbronwissel" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Graduate, Bachelor" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "section", "value": "exercise" },
        { "@type": "PropertyValue", "name": "difficulty", "value": "graduate,bachelor" },
        { "@type": "PropertyValue", "name": "repetitions", "value": "2x per buddy" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "2" },
        { "@type": "PropertyValue", "name": "setupEffort", "value": "gemiddeld" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/loodgordel-transport",
      "@type": "ExercisePlan",
      "name": "Loodgordel transport estafette",
      "description": "Buddyteams verplaatsen loodgordels gecontroleerd tussen vaste punten zonder trimverlies.",
      "activityDuration": "PT10M",
      "supply": [{ "@type": "HowToSupply", "name": "Extra loodgordels" }],
      "step": [
        { "@type": "HowToStep", "text": "Leg 2 startpunten en 2 eindpunten vast in ondiep en diep." },
        { "@type": "HowToStep", "text": "Per ronde vervoert 1 duiker een loodgordel en geeft die over aan buddy." },
        { "@type": "HowToStep", "text": "Buddy plaatst gordel netjes op markering en keert terug." },
        { "@type": "HowToStep", "text": "Wissel rollen elke ronde en bewaak neutraal drijfvermogen." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Belastingscontrole en teamwork" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Initiate, Graduate, Bachelor" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "section", "value": "exercise" },
        { "@type": "PropertyValue", "name": "difficulty", "value": "initiate,graduate,bachelor" },
        { "@type": "PropertyValue", "name": "repetitions", "value": "4 rondes" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "2" },
        { "@type": "PropertyValue", "name": "setupEffort", "value": "gemiddeld" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/figuurkaarten-geheugenparcours",
      "@type": "ExercisePlan",
      "name": "Geheugenparcours met figuurkaarten",
      "description": "Duikers memoriseren onderwater figuurkaarten en reconstrueren het patroon aan de kant.",
      "activityDuration": "PT12M",
      "supply": [{ "@type": "HowToSupply", "name": "Geplastificeerde papieren met figuren" }],
      "step": [
        { "@type": "HowToStep", "text": "Leg 6 figuurkaarten verspreid op de bodem met markeergewicht." },
        { "@type": "HowToStep", "text": "Duiker bekijkt 1 kaart per duik en meldt patroon aan buddy." },
        { "@type": "HowToStep", "text": "Buddy noteert volgorde aan de kant zonder te helpen." },
        { "@type": "HowToStep", "text": "Na volledige ronde vergelijken en herhalen met nieuwe volgorde." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Situational awareness en geheugen" }],
      "audience": { "@type": "PeopleAudience", "audienceType": "Initiate, Graduate" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "section", "value": "exercise" },
        { "@type": "PropertyValue", "name": "difficulty", "value": "initiate,graduate" },
        { "@type": "PropertyValue", "name": "repetitions", "value": "2 patronen" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "2" },
        { "@type": "PropertyValue", "name": "setupEffort", "value": "meer" }
      ]
    }
  ]
}
