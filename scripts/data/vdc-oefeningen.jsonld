        { "@type": "PropertyValue", "name": "repetitions", "value": "4 rondes" },
        { "@type": "PropertyValue", "name": "minCandidates", "value": "2" }
      ]
    },
    {
      "@id": "vdc:exercise/custom/frogkick-backkick-combo",
      "@type": "ExercisePlan",
      "name": "Frogkick en backkick combinatie",
      "description": "Techniekcircuit met frogkick vooruit en backkick achteruit op korte afstanden.",
      "activityDuration": "PT15M",
      "step": [
        { "@type": "HowToStep", "text": "Demonstreer eerst traag frogkick en backkick." },
        { "@type": "HowToStep", "text": "Laat elke duiker 1 lengte frogkick en halve lengte backkick doen." },
        { "@type": "HowToStep", "text": "Buddy geeft feedback op kniehoek en vinpositie." },
        { "@type": "HowToStep", "text": "Eindig met gecombineerde ronde zonder handgebruik." }
      ],
      "teaches": [{ "@type": "DefinedTerm", "name": "Fintechniek precisie" }],
